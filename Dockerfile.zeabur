# syntax=docker/dockerfile:1.7
# PandaFactor single-container image for Zeabur.
# One container runs: nginx (port 3000, HTTP Basic Auth) in front of
# uvicorn panda_factor_server (port 8111), which serves /api/v1, /llm
# and the Vue frontend at /factor.
# MongoDB comes from the Zeabur marketplace service via env vars (see DEPLOY.md).
# Empty DB is fine for M1: pages open, API returns empty until data is loaded.
#
# Build stages mirror the repo's own Dockerfile.server, with two fixes:
#   1. panda_web/ is copied too (Dockerfile.server omits it, but the server
#      mounts /app/panda_web/panda_web/static at /factor and crashes without it).
#   2. config.yaml secrets are scrubbed (see config.yaml.scrubbed); real values
#      come from Zeabur Variables at runtime.

FROM python:3.12-slim

ENV TZ=Asia/Shanghai
RUN apt-get update && apt-get install -y tzdata nginx openssl wget && \
    ln -fs /usr/share/zoneinfo/${TZ} /etc/localtime && \
    dpkg-reconfigure -f noninteractive tzdata && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY panda_common/ /app/panda_common/
COPY panda_data/ /app/panda_data/
COPY panda_data_hub/ /app/panda_data_hub/
COPY panda_factor/ /app/panda_factor/
COPY panda_factor_server/ /app/panda_factor_server/
COPY panda_llm/ /app/panda_llm/
COPY panda_web/ /app/panda_web/
COPY requirements.txt /app/

WORKDIR /app/panda_factor_server

RUN for dir in /app/panda_common /app/panda_data /app/panda_data_hub /app/panda_factor /app/panda_factor_server /app/panda_llm /app/panda_web; do \
    rm -rf $dir/dist/* $dir/build/* $dir/*.egg-info; \
    done

# Build all wheels in dependency order (mirrors Dockerfile.server)
RUN cd /app/panda_common && python setup.py bdist_wheel && \
    cd /app/panda_data && python setup.py bdist_wheel && \
    cd /app/panda_data_hub && python setup.py bdist_wheel && \
    cd /app/panda_llm && python setup.py bdist_wheel && \
    cd /app/panda_factor && python setup.py bdist_wheel && \
    cd /app/panda_factor_server && python setup.py bdist_wheel

RUN pip install --no-deps /app/panda_common/dist/*.whl && \
    pip install --no-deps /app/panda_data/dist/*.whl && \
    pip install --no-deps /app/panda_data_hub/dist/*.whl && \
    pip install --no-deps /app/panda_llm/dist/*.whl && \
    pip install --no-deps /app/panda_factor/dist/*.whl && \
    pip install /app/panda_factor_server/dist/*.whl

RUN pip install --no-cache-dir -r /app/requirements.txt -i https://mirrors.aliyun.com/pypi/simple/

ENV PYTHONPATH=/app/panda_factor_server

# nginx: Basic Auth reverse proxy in front of uvicorn
COPY nginx.zeabur.conf /etc/nginx/conf.d/default.conf
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh && rm -f /etc/nginx/sites-enabled/default

EXPOSE 3000
# Healthcheck hits uvicorn directly (bypasses Basic Auth on nginx)
HEALTHCHECK --interval=30s --timeout=5s --start-period=90s --retries=3 \
    CMD wget -qO- http://127.0.0.1:8111/ >/dev/null || exit 1
ENTRYPOINT ["/entrypoint.sh"]
